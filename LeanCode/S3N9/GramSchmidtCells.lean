/-!
# The constants of the Gram–Schmidt cells

The virtual-root certificates of the source are stated on Gram–Schmidt cells (Section 5 of its paper). A cell
has caps `cA`, `cB` of its two near pairs, a tilt bound `δ`, and constants `σ`, `εAP`, `εAQ`, `κA`, `εBP`,
`εBQ`, `κB`, `κθ`, `εR`, `σAB`, `σAR`, `σBR`, which have to satisfy the conditions (C1) to (C5) of the paper
(`GSCell.Valid`); with `ηA = (1 - cA) / 2`, `ηB = (1 - cB) / 2` and the separation bound `T`:

* (C1) `2 δ ≤ σ √((1 + cA) (1 + cB))` and `σ² + ηB < 1`;
* (C2) `1 - √(1 - ηA) ≤ εAP ≤ 1`, `√ηA ≤ εAQ` and `ηA ≤ κA² (1 - ηA)`;
* (C3) `1 - c* ≤ εBP`, `s* ≤ εBQ`, `s* ≤ κB c*` and `σ² ≤ κθ² (1 - σ²)`, where
  `c* = √((1 - σ²) (1 - ηB)) - σ √ηB` and `s* = σ √(1 - ηB) + √((1 - σ²) ηB)`;
* (C4) `(1 + σ) H ≤ εR √(1 - σ²)`, `εR < 1` and `ηA, ηB ≤ 1 - T²`, where
  `H = T √((1 + c) / 2) + √((1 - c) (1 - T²) / 2)` for `c = min cA cB`;
* (C5) `√(ηA ηB) + εAP εBQ + εBP εAQ ≤ σAB`, `√ηA + (εAP + εAQ) εR ≤ σAR` and `√ηB + (εBP + εBQ) εR ≤ σBR`.

`cell10_valid`, `cell30_valid`: the two sets of constants of the source, for the tilt bounds `1 / 10` and
`3 / 10` (the five cells of the proof use them), satisfy the conditions. `lstar_le`: the lower end
`-657377 / 10 ^ 6` of the intervals between a point of a near pair and a ring point is at most the cap
bound `-(c T + √((1 - c²) (1 - T²)))` for `c = 99 / 100`. Together this is the computational statement of
the source on its cells (C5 of `S3N9/README.md`).

Every square root is enclosed between two rationals, by squaring, and every condition is linear in the
square roots. This file is generated by `python3 -m certgen.s3n9_gscells`, which checks the conditions
with the same enclosures in exact arithmetic. Do not edit.
-/

@[expose] public section

namespace S3N9

/-- The constants of a Gram–Schmidt cell that enter the conditions (C1) to (C5), and the separation bound. -/
structure GSCell where
  cA : ℝ
  cB : ℝ
  δ : ℝ
  T : ℝ
  σ : ℝ
  εAP : ℝ
  εAQ : ℝ
  κA : ℝ
  εBP : ℝ
  εBQ : ℝ
  κB : ℝ
  κθ : ℝ
  εR : ℝ
  σAB : ℝ
  σAR : ℝ
  σBR : ℝ

namespace GSCell

noncomputable def ηA (C : GSCell) : ℝ := (1 - C.cA) / 2

noncomputable def ηB (C : GSCell) : ℝ := (1 - C.cB) / 2

/-- `cos (ϑmax + φB)` for `sin ϑmax = σ` and `sin φB = √ηB`. -/
noncomputable def cstar (C : GSCell) : ℝ := √((1 - C.σ ^ 2) * (1 - C.ηB)) - C.σ * √C.ηB

/-- `sin (ϑmax + φB)`. -/
noncomputable def sstar (C : GSCell) : ℝ := C.σ * √(1 - C.ηB) + √((1 - C.σ ^ 2) * C.ηB)

/-- The bound for the coordinates of a ring point along a near pair. -/
noncomputable def hcap (C : GSCell) (c : ℝ) : ℝ := C.T * √((1 + c) / 2) + √((1 - c) * (1 - C.T ^ 2) / 2)

/-- The conditions (C1) to (C5) on the constants of a cell. -/
structure Valid (C : GSCell) : Prop where
  c1a : 2 * C.δ ≤ C.σ * √((1 + C.cA) * (1 + C.cB))
  c1b : C.σ ^ 2 + C.ηB < 1
  c2a : 1 - √(1 - C.ηA) ≤ C.εAP
  c2b : C.εAP ≤ 1
  c2c : √C.ηA ≤ C.εAQ
  c2d : C.ηA ≤ C.κA ^ 2 * (1 - C.ηA)
  c3a : 1 - C.cstar ≤ C.εBP
  c3b : C.sstar ≤ C.εBQ
  c3c : C.sstar ≤ C.κB * C.cstar
  c3d : C.σ ^ 2 ≤ C.κθ ^ 2 * (1 - C.σ ^ 2)
  c4a : (1 + C.σ) * C.hcap (min C.cA C.cB) ≤ C.εR * √(1 - C.σ ^ 2)
  c4b : C.εR < 1
  c4c : C.ηA ≤ 1 - C.T ^ 2
  c4d : C.ηB ≤ 1 - C.T ^ 2
  c5a : √(C.ηA * C.ηB) + C.εAP * C.εBQ + C.εBP * C.εAQ ≤ C.σAB
  c5b : √C.ηA + (C.εAP + C.εAQ) * C.εR ≤ C.σAR
  c5c : √C.ηB + (C.εBP + C.εBQ) * C.εR ≤ C.σBR

end GSCell

/-- A square root between two rationals, by squaring. -/
theorem sqrt_between {q lo hi : ℝ} (hlo : 0 ≤ lo) (h1 : lo ^ 2 ≤ q) (hhi : 0 ≤ hi) (h2 : q ≤ hi ^ 2) :
    lo ≤ √q ∧ √q ≤ hi := by
  constructor
  · calc lo = √(lo ^ 2) := (Real.sqrt_sq hlo).symm
      _ ≤ √q := Real.sqrt_le_sqrt h1
  · calc √q ≤ √(hi ^ 2) := Real.sqrt_le_sqrt h2
      _ = hi := Real.sqrt_sq hhi

